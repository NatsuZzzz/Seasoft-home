{
  "name": "seasoft-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Build CSS cho frontend SeaSoft (Html/)",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i Html/css/tailwind.input.css -o Html/css/tailwind.css --minify",
