# Copy file nay thanh .env roi dien gia tri that (.env khong duoc commit)
DB_URL=jdbc:postgresql://localhost:5432/SeaSoft
DB_USERNAME=postgres
DB_PASSWORD=
# Tao secret moi: openssl rand -base64 32
JWT_SECRET=
# JWT_EXPIRATION=86400000
# CORS_ORIGINS=https://seasoft.vn

# Tai khoan ADMIN dau tien (chi tao khi DB chua co admin nao, mat khau >= 8 ky tu)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# LEAD_NOTIFY_EMAIL=sales@seasoft.vn

# Luu y: .env doc theo ISO-8859-1 -> gia tri dung chu KHONG dau (vd ADMIN_NAME=Admin)
