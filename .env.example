# Bien moi truong cho ban deploy (docker compose / Render / Railway / VPS).
# Docker compose: copy thanh .env canh docker-compose.yml. Hosting: dien vao muc Environment cua dashboard.
# KHONG commit file .env that. Gia tri dung chu KHONG dau.

# ---------- Database ----------
# Docker compose tu dat DB_URL/DB_USERNAME tro vao container db, chi can DB_PASSWORD.
# Render/Railway + Neon: DB_URL=jdbc:postgresql://<host>/<db>?sslmode=require
DB_PASSWORD=
# DB_URL=
# DB_USERNAME=

# ---------- Bao mat ----------
# Tao secret: openssl rand -base64 48   (>= 32 byte, secret yeu -> app khong khoi dong)
JWT_SECRET=
# Domain that, cach nhau dau phay. Vd: https://seasoft.vn,https://www.seasoft.vn
CORS_ORIGINS=http://localhost:8080
# Link trong email tro ve day (khong co / cuoi)
FRONTEND_URL=http://localhost:8080

# ---------- ADMIN dau tien (chi tao khi DB chua co admin; mat khau >= 8 ky tu) ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ---------- Mail (bo trong SPRING_MAIL_HOST = chi log ra console, khong gui that) ----------
# SPRING_MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@seasoft.vn
# LEAD_NOTIFY_EMAIL=

# ---------- Tinh nang ----------
# Blog cong khai (tam tat)
FEATURE_BLOG=false
